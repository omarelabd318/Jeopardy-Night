// 5.7: lets Cloudflare ("npx wrangler deploy" in Workers & Pages) serve the game as a plain static site.
// Every merge to main redeploys it. The build step copies only what the browser needs into dist/
// (the page, the speed test, photos and sounds), so src/, v4work/ and .git are never uploaded.
{
  "name": "jeopardy-night",
  "compatibility_date": "2026-10-01",
  // Keep the free jeopardy-night.<account>.workers.dev address switched on with every deploy.
  "workers_dev": true,
  "build": {
    "command": "rm -rf dist && mkdir dist && cp -r index.html speed.html photos sounds dist/"
  },
  "assets": {
    "directory": "./dist"
  }
}
