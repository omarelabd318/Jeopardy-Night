// 5.7: lets Cloudflare ("npx wrangler deploy" in Workers & Pages) serve the game as a plain static site.
// Every merge to main redeploys it. The build step copies only what the browser needs into dist/
// (the page, the phone answer page, the free-for-all player page (5.26), the speed test, photos and sounds), so src/, v4work/ and .git are never uploaded.
// 5.9: worker/index.js answers /api/* (the phone-answer relay); everything else is served straight from dist/.
{
  "name": "jeopardy-night",
  "compatibility_date": "2026-10-01",
  // Keep the free jeopardy-night.<account>.workers.dev address switched on with every deploy.
  "workers_dev": true,
  "main": "worker/index.js",
  "build": {
    "command": "rm -rf dist && mkdir dist && cp -r index.html answer.html play.html spy.html psych.html dec.html cards.html cards.js cn.html sale.html liars.html taboo.html draw.html hues.html buzz.html speed.html photos sounds dist/"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 7.41: the game page goes through worker/index.js first, so the old jeopardy-night address can forward it to sahra. Everything else is still served straight from dist/.
    "run_worker_first": ["/", "/index.html"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are included in Cloudflare's free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // 8.72 (Omar): Logs switched on in the dashboard (Observability). Kept here too, so a deploy from GitHub
  // doesn't switch them back off. Applies to both Worker projects (sahra and jeopardy-night). To undo, delete this block.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true },
    "issue_detection": { "enabled": false }
  }
}
